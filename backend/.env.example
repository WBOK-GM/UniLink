# ====================================================================
# UniLink Backend - Variables de Entorno y Configuración de Credenciales
# ====================================================================

# 1. Servidor y Entorno
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# 2. Seguridad y Autenticación JWT
# Requerido: Genera una cadena aleatoria segura para firmar los tokens JWT
JWT_SECRET=unilink_super_secret_jwt_key_2026_academics
JWT_EXPIRES_IN=7d

# 3. Base de Datos PostgreSQL (Neon Free / Servidor Local)
# Si se deja vacío o no conecta, el backend usará el adaptador en memoria con seed inicial
# Formato Neon: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# 4. Almacenamiento en la Nube (Cloudflare R2 - Compatible S3)
# Si se dejan vacíos, el backend usará automáticamente el almacenamiento local en disco (/uploads)
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=unilink-academic-files
CLOUDFLARE_R2_PUBLIC_DOMAIN=https://pub-your-bucket-id.r2.dev

# 5. Notificaciones Web Push (VAPID)
# Generables mediante: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=BH6LM-jt3b3N1pw8LVSmnm3zS6U67XW8JzANZ02NW6dQy_TryhzbKMdSSmABl90Bh5XRCcMxUv_pAi1GzYDO-YE
VAPID_PRIVATE_KEY=LxEMebYLb1KMgc3p5ToxcWNij6sc1nZHA3SsXYezrCU
VAPID_SUBJECT=mailto:soporte@unilink.edu.co
